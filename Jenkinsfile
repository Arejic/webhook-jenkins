groovy
pipeline {
    agent any

    stages {
        stage('Inicio') {
            steps {
                echo '🚀 Jenkins inició el pipeline'
            }
        }

        stage('Prueba') {
            steps {
                echo '✅ Pipeline ejecutándose correctamente'
            }
        }

        stage('Finalizado') {
            steps {
                echo '🎉 Integración continua funcionando'
            }
        }
    }
}
