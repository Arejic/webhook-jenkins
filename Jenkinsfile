pipeline {
    agent any

    stages {
        stage('Inicio') {
            steps {
                echo 'Jenkins inicio el pipeline'
            }
        }

        stage('Prueba') {
            steps {
                echo 'Pipeline ejecutandose correctamente'
            }
        }

        stage('Finalizado') {
            steps {
                echo 'Integracion continua funcionando'
            }
        }
    }
}
